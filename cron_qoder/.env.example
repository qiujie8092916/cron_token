# Required. Create a PAT at https://qoder.com/account/integrations
ACCESS_TOKEN=

# Required. Text sent to Qoder on every scheduled run.
# For multiline content, wrap the value in double quotes and use \n escapes.
CONTENT="Reply with a short status update."

# Required. Comma-separated ordered fallback list. Whitespace, empty entries,
# and duplicates are removed while preserving first-seen order.
# Built-in tiers: lite, efficient, auto, performance, ultimate
# Account-specific model IDs are also accepted and are checked only on use.
MODELS=lite,efficient,auto

# Required. Standard five-field cron: minute hour day-of-month month weekday
CRON=*/5 * * * *

# Optional. Must be a valid IANA time zone.
TZ=Asia/Shanghai

# Optional. Strictly true or false.
RUN_ON_START=false

# Optional. Total deadline for one queued job, covering every model attempt and
# the delays between attempts. Must be a positive integer. Default: 30000.
REQUEST_TIMEOUT_MS=30000

# Optional. Delay before trying the next model. Must be a non-negative integer.
# Default: 5000.
RETRY_DELAY_MS=5000
