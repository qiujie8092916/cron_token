# Shared timezone and notification settings
TZ=Asia/Shanghai

# email (default), dingtalk, or email,dingtalk
NOTIFY_CHANNELS=dingtalk

# DingTalk custom robot webhook. DINGTALK_SECRET is optional but recommended.
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=replace-with-access-token
DINGTALK_SECRET=SEC-replace-with-signing-secret
DINGTALK_AT_ALL_ON_FAILURE=true

# SMTP settings are only required when NOTIFY_CHANNELS includes email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=user@example.com
MAIL_TO=admin@example.com
