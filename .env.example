# 必填
DOMAIN=https://example.com
API_KEY=replace-with-your-api-key

# 可选：默认“你好”
CONTENT=你好
# 可选：失败后的额外重试次数，默认 3
RETRY_COUNT=3
# 可选：Cron 表达式，默认每天 10:00
CRON=0 10 * * *
# 可选：Cron 使用的时区
TZ=Asia/Shanghai
# 可选：容器启动后是否立即执行一次
RUN_ON_START=false
# 可选：单次请求超时及重试间隔（毫秒）
REQUEST_TIMEOUT_MS=30000
RETRY_DELAY_MS=5000

# 邮件告警（必填）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER/SMTP_PASS 对无需认证的 SMTP 中继可留空
SMTP_USER=user@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=user@example.com
MAIL_TO=admin@example.com
